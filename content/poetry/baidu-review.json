  "notes": {
    "6":[["返景","夕阳返照的光。这里景按普通话读jǐng；部分旧注按通影读yǐng，学习时可留意所用教材。"]],
    "24":[["只","这里只读zhǐ，意思是仅仅、只是。"]],
    "53":[["教吹箫","教人吹箫，教取jiāo。玉人所指有不同解说，常理解为美好的人或对朋友的雅称。"]],
    "58":[["笼","笼罩、覆盖，读lǒng。烟与月色分别笼着水和沙。"]],
    "81":[["城阙","都城的城楼、宫阙，这里指长安。阙读què。"]],
    "104":[["占梦","据梦境推测吉凶，属于古人的观念；占读zhān。诗中写思念的人反复揣测梦境。"]],
    "116":[["只独看","只是独自望月。只读zhǐ。"]],
    "127":[["场圃","打谷场与菜园。场在打谷场这一意思中读cháng。"]],
    "137":[["夹","分列两边，读jiā。苍山夹着奔流的江水。"]],
    "171":[["了无益","全无益处。了读liǎo，表示完全。"]],
    "176":[["射覆","古代宴席上的猜物游戏，覆指遮盖。本版将底本射复校为射覆。"]],
    "177":[["残宵","将尽的夜晚。宵指夜，底本作残霄，这里采用残宵。"]],
    "191":[["多难","多灾多难，难读nàn。这里关切的是国家与百姓面临的艰难。"]],
    "193":[["旧醅","隔年的未滤酒。醅读pēi，只旧醅的只读zhǐ，意为只有。"]],
    "202":[["空余","只留下，空读kōng。仙人离去，黄鹤楼仍然留在这里。"]],
    "227":[["岱宗","泰山的尊称。夫如何的夫是语气词，读fú。"]],
    "230":[["荠","荠菜，读jì。远处树林小得像荠菜，突出江天辽阔。"]],
    "231":[["散发","解开发髻，披散头发，发读fà；写乘凉时自在放松的样子。"]],
    "259":[["都统","统领军队的官职，都读dū。诗中指裴度。"],["愬武古通","指李愬、韩公武、李道古、李文通等将领。愬读sù。"],["牙爪","爪牙，比喻得力的将领，爪读zhǎo。"],["烜赫","声势显盛，烜读xuǎn。"],["封禅","古代帝王祭祀天地的仪式，禅读shàn。"],["元和","唐宪宗年号，诗中平淮西发生于这一时期。"],["韩碑","韩愈所撰《平淮西碑》。诗通过碑文的遭遇议论功业与公正评价。"]],
    "262":[["陇","陇山及其周边地区，诗中写边地山云与飞雪。"]],
    "268":[["玉花骢","唐玄宗御马的名字。骢读cōng，指青白杂毛的马。下文玉花指同一匹马。"],["凌烟","凌烟阁，唐代绘有功臣画像的楼阁。"],["龙","这里以龙比喻神骏的马，强调画作传神。"]],
    "274":[["为人鞿","受他人约束、被世事牵制。为读wéi，鞿读jī，本指马缰绳。"]],
    "286":[["夹古津","桃花开在古渡两边，夹读jiā。"]],
    "287":[["槛","栏杆，读jiàn。春风拂过栏杆，花上露水晶莹。"]],
    "298":[["号古木","在古树间鸣叫。号在这里读háo。"],["胡为乎来哉","为什么要来到这里呢？胡为指为什么，为读wéi。"],["倒挂","上下颠倒地悬挂，倒读dào。写枯松倚靠峭壁的险峻姿态。"],["五丁","传说中的五位力士。诗借古蜀传说描绘蜀道开辟之难。"]],
    "300":[["若耶","若耶溪，在今浙江绍兴一带，若耶读ruò yé。"]],
    "306":[["橐驼","骆驼，橐读tuó。旧都在诗中指长安，都读dū。"]],
    "307":[["点行频","频繁点名征发出行服役，点行读diǎn xíng。反映当时百姓承受的征役。"]],
    "172":[["只系","只是拴系在岸边。只读zhǐ，系读jì。"]],
    "203":[["削不成","山峰峭拔奇绝，仿佛人工也无法削成，削读xuē。"]],
    "229":[["插发","把花插在头发上，发读fà。佳人摘花而不插，写她无心修饰。"]],
    "234":[["了无取","完全不执取，了读liǎo；句中表达不被外在形迹拘束的意思。"]],
    "250":[["醉和春","沉醉在和暖春光中，和读hé。"],["城阙","都城的城楼与宫阙，阙读què。"],["都门","京城的城门，都读dū。诗中指长安。"],["鸿都","东汉宫门名，后借指京城；都读dū。"],["辗转","反复回旋、难以安定，辗读zhǎn；写思念难眠。"],["缥渺","同缥缈，隐隐约约、若有若无的样子，读piāo miǎo。"]],
    "273":[["委蛇","曲折舒展、从容自在的样子，读wēi yí；诗中评价文字的气势与风格。"],["好古","喜爱古代事物与文化，好读hào。"],["石鼓","刻有古老文字的鼓形石刻，是诗中珍惜和希望保护的文物。"],["镌功勒成","刻石记录功业。镌读juān，勒读lè。"]],
    "275":[["只得","只能、不得不，只读zhǐ。"]],
    "281":[["裁缝歇","停止裁剪缝衣。缝在这里是动作，读féng。"]],
    "309":[["曲江曲","曲江的弯曲处。曲江是长安名胜，曲江读qǔ jiāng；末字曲指河湾，读qū。"]],
    "313":[["密密缝","把针脚缝得细密。缝读féng，表现临别前母亲的牵挂。"]]
  }
}
